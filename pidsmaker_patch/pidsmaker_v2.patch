+"""Phase 0/1 acceptance: model checkpoint round-trip, and native class posteriors.
+
+Checkpointing was disabled because `save_model` read `model.encoder.neighbor_loader`, which does
+not exist on this version's TGNEncoder (`neighbor_loader` is a local of the batching helper). These
+tests pin the guarded behaviour and the posterior contract the MIA attacks depend on.
+
+Run:  pytest tests/test_checkpoint_and_posterior.py -v
+"""
+
+import os
+
+import pytest
+import torch
+import torch.nn as nn
+
+from pidsmaker.utils.data_utils import load_model, save_model
+
+
+class _FakeTGN(nn.Module):
+    """Stands in for TGNEncoder: has `memory`, deliberately has NO `neighbor_loader`."""
+
+    def __init__(self):
+        super().__init__()
+        self.lin = nn.Linear(4, 3)
+        self.memory = nn.Parameter(torch.randn(5, 4), requires_grad=False)
+
+
+class _FakeModel(nn.Module):
+    def __init__(self, encoder):
+        super().__init__()
+        self.encoder = encoder
+        self.head = nn.Linear(3, 2)
+
+
+class _Ns:
+    """Attribute bag, so the fake cfg reads like the real dotted config."""
+
+    def __init__(self, **kw):
+        self.__dict__.update(kw)
+
+
+def _Cfg():
+    """Minimal duck-typed cfg exposing only what save_model/load_model read."""
+    return _Ns(
+        training=_Ns(encoder=_Ns(tgn=_Ns(use_memory=False))),
+        batching=_Ns(edge_features=["edge_type"]),
+    )
+
+
+def test_save_model_does_not_crash_without_neighbor_loader(tmp_path, monkeypatch):
+    """The regression that disabled checkpointing: encoder has no `neighbor_loader` attribute."""
+    import pidsmaker.utils.data_utils as du
+
+    monkeypatch.setattr(du, "TGNEncoder", _FakeTGN)  # make isinstance() take the TGN branch
+    model = _FakeModel(_FakeTGN())
+    assert not hasattr(model.encoder, "neighbor_loader")
+
+    save_model(model, str(tmp_path / "ckpt"), _Cfg())
+
+    assert os.path.exists(tmp_path / "ckpt" / "state_dict.pkl")
+    assert not os.path.exists(tmp_path / "ckpt" / "neighbor_loader.pkl"), (
+        "must not write a file for an attribute the encoder does not have"
+    )
+
+
+def test_save_load_round_trip_restores_every_tensor(tmp_path, monkeypatch):
+    import pidsmaker.utils.data_utils as du
+
+    monkeypatch.setattr(du, "TGNEncoder", _FakeTGN)
+    src = _FakeModel(_FakeTGN())
+    save_model(src, str(tmp_path / "ckpt"), _Cfg())
+
+    dst = _FakeModel(_FakeTGN())
+    # sanity: the fresh model really is different before loading
+    assert not torch.allclose(src.head.weight, dst.head.weight)
+
+    load_model(dst, str(tmp_path / "ckpt"), _Cfg())
+
+    for k, v in src.state_dict().items():
+        assert torch.equal(v, dst.state_dict()[k]), f"{k} not restored"
+
+
+def test_load_model_tolerates_absent_neighbor_loader_file(tmp_path, monkeypatch):
+    """load_model must mirror save_model: no file written => no file expected."""
+    import pidsmaker.utils.data_utils as du
+
+    monkeypatch.setattr(du, "TGNEncoder", _FakeTGN)
+    save_model(_FakeModel(_FakeTGN()), str(tmp_path / "ckpt"), _Cfg())
+    load_model(_FakeModel(_FakeTGN()), str(tmp_path / "ckpt"), _Cfg())  # must not raise
+
+
+# --------------------------------------------------------------------------------------------
+# Phase 1: native class posteriors
+# --------------------------------------------------------------------------------------------
+
+
+class _IdentityDecoder(nn.Module):
+    def forward(self, h=None, h_src=None, h_dst=None):
+        return h if h is not None else h_src + h_dst
+
+
+def _one_hot(idx, n):
+    return torch.nn.functional.one_hot(idx, n).float()
+
+
+def test_edge_type_posterior_shape_normalisation_and_argmax():
+    from pidsmaker.objectives.predict_edge_type import EdgeTypePrediction
+
+    E, C = 7, 10
+    obj = EdgeTypePrediction(
+        decoder=_IdentityDecoder(),
+        loss_fn=lambda h, y, inference, class_weights: torch.zeros(len(h)),
+        balanced_loss=False,
+        edge_type_dim=C,
+    )
+    h_src, h_dst = torch.randn(E, C), torch.randn(E, C)
+    edge_type = _one_hot(torch.randint(0, C, (E,)), C)
+
+    out = obj(h_src=h_src, h_dst=h_dst, edge_type=edge_type, inference=True)
+
+    assert out["posterior"].shape == (E, C)
+    assert torch.allclose(out["posterior"].sum(1), torch.ones(E), atol=1e-5)
+    assert torch.equal(out["posterior"].argmax(1), out["logits"].argmax(1))
+
+
+def test_edge_type_posterior_absent_during_training():
+    """Training must be untouched -- posteriors are an inference-only observable."""
+    from pidsmaker.objectives.predict_edge_type import EdgeTypePrediction
+
+    E, C = 7, 10
+    obj = EdgeTypePrediction(
+        decoder=_IdentityDecoder(),
+        loss_fn=lambda h, y, inference, class_weights: torch.zeros(1),
+        balanced_loss=False,
+        edge_type_dim=C,
+    )
+    out = obj(
+        h_src=torch.randn(E, C),
+        h_dst=torch.randn(E, C),
+        edge_type=_one_hot(torch.randint(0, C, (E,)), C),
+        inference=False,
+    )
+    assert "posterior" not in out and "logits" not in out
+
+
+def test_node_type_posterior_comes_from_decoder_logits_not_embedding():
+    """The posterior must be softmax(h_hat). A non-identity decoder makes h and h_hat differ, so
+    a posterior built from `h` (as the legacy "out" key is) would be wrong."""
+    from pidsmaker.objectives.predict_node_type import NodeTypePrediction
+
+    N, D, C = 6, 8, 3
+
+    class _Proj(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.lin = nn.Linear(D, C)
+
+        def forward(self, h):
+            return self.lin(h)
+
+    decoder = _Proj()
+    obj = NodeTypePrediction(
+        decoder=decoder,
+        loss_fn=lambda h, y, inference, weight: torch.zeros(len(h)),
+        balanced_loss=False,
+        node_type_dim=C,
+    )
+    h = torch.randn(N, D)
+    out = obj(h=h, node_type=_one_hot(torch.randint(0, C, (N,)), C), inference=True)
+
+    assert out["posterior"].shape == (N, C)
+    assert torch.allclose(out["posterior"].sum(1), torch.ones(N), atol=1e-5)
+    expected = torch.softmax(decoder(h), dim=1)
+    assert torch.allclose(out["posterior"], expected, atol=1e-6), "posterior must use h_hat"
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))
diff --git a/tests/test_feat_inference_equivalence.py b/tests/test_feat_inference_equivalence.py
new file mode 100644
index 0000000..31a8efd
--- /dev/null
+++ b/tests/test_feat_inference_equivalence.py
@@ -0,0 +1,115 @@
+"""The preallocated `feat_inference` must produce exactly what the list-of-tensors version did.
+
+That function was rewritten to stop R-CAID OOMing on E3-THEIA (side task S4). It feeds every
+downstream task, so "uses less memory" is worth nothing unless the bytes are identical: a silent
+change to the message-column layout would retrain every detector on differently-ordered features
+and invalidate the detection tables without failing anything visibly.
+
+The reference below is the original implementation, copied verbatim.
+"""
+
+import networkx as nx
+import numpy as np
+import pytest
+import torch
+
+from pidsmaker.tasks.feat_inference import feat_inference
+from pidsmaker.utils.utils import gen_relation_onehot
+
+
+def _reference(indexid2vec, etype2oh, ntype2oh, graph):
+    """The pre-S4 implementation, kept here as the oracle."""
+    src, dst, msg, t, y = [], [], [], [], []
+    for u, v, k, attr in graph.edges(data=True, keys=True):
+        src.append(int(u))
+        dst.append(int(v))
+        t.append(int(attr["time"]))
+        y.append(int(attr.get("y", 0)))
+
+        if "label" in attr:
+            edge_label = etype2oh[attr["label"]]
+        else:
+            edge_label = torch.zeros_like(etype2oh[list(etype2oh.keys())[0]])
+
+        if indexid2vec is None:
+            msg.append(torch.cat([
+                ntype2oh[graph.nodes[u]["node_type"]],
+                edge_label,
+                ntype2oh[graph.nodes[v]["node_type"]],
+            ]))
+        else:
+            msg.append(torch.cat([
+                ntype2oh[graph.nodes[u]["node_type"]],
+                torch.from_numpy(indexid2vec[u]),
+                edge_label,
+                ntype2oh[graph.nodes[v]["node_type"]],
+                torch.from_numpy(indexid2vec[v]),
+            ]))
+
+    return {
+        "src": torch.tensor(src).to(torch.long),
+        "dst": torch.tensor(dst).to(torch.long),
+        "t": torch.tensor(t).to(torch.long),
+        "msg": torch.vstack(msg).to(torch.float),
+        "y": torch.tensor(y).to(torch.long),
+    }
+
+
+def _build(n_nodes=12, n_edges=40, seed=0, with_labels=True):
+    rng = np.random.default_rng(seed)
+    rel2id = {"read": 1, "write": 2, "execute": 3, 1: "read", 2: "write", 3: "execute"}
+    ntype2id = {"file": 1, "process": 2, 1: "file", 2: "process"}
+    etype2oh = gen_relation_onehot(rel2id)
+    ntype2oh = gen_relation_onehot(ntype2id)
+
+    g = nx.MultiDiGraph()
+    for n in range(n_nodes):
+        g.add_node(n, node_type="file" if n % 2 else "process")
+    labels = ["read", "write", "execute"]
+    for i in range(n_edges):
+        u, v = int(rng.integers(n_nodes)), int(rng.integers(n_nodes))
+        attr = {"time": 1000 + i, "y": int(i % 7 == 0)}
+        if with_labels:
+            attr["label"] = labels[i % len(labels)]
+        g.add_edge(u, v, **attr)
+
+    indexid2vec = {n: rng.normal(size=8).astype(np.float32) for n in range(n_nodes)}
+    return g, etype2oh, ntype2oh, indexid2vec
+
+
+@pytest.mark.parametrize("use_embeddings", [True, False])
+@pytest.mark.parametrize("with_labels", [True, False])
+def test_matches_reference(tmp_path, use_embeddings, with_labels):
+    g, etype2oh, ntype2oh, indexid2vec = _build(with_labels=with_labels)
+    vecs = indexid2vec if use_embeddings else None
+
+    graph_path = tmp_path / "graph.pt"
+    torch.save(g, graph_path)
+    out_dir = tmp_path / "out"
+
+    feat_inference(vecs, etype2oh, ntype2oh, [str(graph_path)], str(out_dir), cfg=None)
+    got = torch.load(out_dir / "graph.pt.TemporalData.simple", weights_only=False)
+    want = _reference(vecs, etype2oh, ntype2oh, g)
+
+    for field in ("src", "dst", "t", "y"):
+        assert torch.equal(getattr(got, field), want[field]), field
+    assert got.msg.shape == want["msg"].shape
+    assert got.msg.dtype == want["msg"].dtype == torch.float32
+    assert torch.equal(got.msg, want["msg"]), "message matrix differs from the reference"
+
+
+def test_empty_graph_keeps_the_column_layout(tmp_path):
+    """A time window with no edges must still yield the right msg width, or concatenating it with
+    other windows downstream would fail on a shape mismatch."""
+    g, etype2oh, ntype2oh, indexid2vec = _build()
+    empty = nx.MultiDiGraph()
+    graph_path = tmp_path / "empty.pt"
+    torch.save(empty, graph_path)
+    out_dir = tmp_path / "out"
+
+    feat_inference(indexid2vec, etype2oh, ntype2oh, [str(graph_path)], str(out_dir), cfg=None)
+    got = torch.load(out_dir / "empty.pt.TemporalData.simple", weights_only=False)
+
+    n_dim = len(next(v for v in ntype2oh.values() if torch.is_tensor(v)))
+    e_dim = len(next(v for v in etype2oh.values() if torch.is_tensor(v)))
+    assert got.msg.shape == (0, 2 * n_dim + e_dim + 2 * 8)
diff --git a/tests/test_low_memory_loading_equivalence.py b/tests/test_low_memory_loading_equivalence.py
new file mode 100644
index 0000000..b7b3ba8
--- /dev/null
+++ b/tests/test_low_memory_loading_equivalence.py
@@ -0,0 +1,210 @@
+"""The low-memory loading path (PIDS_LOW_MEMORY=1) must hand the training loop the same windows
+as the eager `load_all_datasets` pipeline, minus exactly the three attributes nothing reads after
+reindexing in a non-TGN run: `msg`, `x_src`, `x_dst`.
+
+Both paths run here on CPU against the same synthetic feat_inference artifact tree, and every
+surviving tensor of every window is compared exactly. CPU matters: eager reindexing normally runs
+on the training device, and CUDA scatter-mean is nondeterministic-atomics; on CPU both paths are
+deterministic, so equality is exact rather than approximate.
+"""
+
+import os
+import sys
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from pidsmaker.factory import get_dimensions_from_data_sample
+from pidsmaker.utils.data_utils import (
+    CollatableTemporalData,
+    load_all_datasets,
+)
+
+EMB_DIM = 4
+N_TYPES = 3
+E_TYPES = 5
+MSG_LEN = 2 * EMB_DIM + 2 * N_TYPES + E_TYPES
+
+
+def make_cfg(edge_embeds_dir, encoder="rcaid_gat"):
+    return NS(
+        featurization=NS(emb_dim=EMB_DIM, used_method="doc2vec"),
+        dataset=NS(num_node_types=N_TYPES, num_edge_types=E_TYPES, name="CADETS_E3"),
+        batching=NS(
+            node_features="node_emb",
+            edge_features="none",
+            fix_buggy_graph_reindexer=False,
+            multi_dataset_training=False,
+            save_on_disk=False,
+            global_batching=NS(
+                used_method="none",
+                global_batching_batch_size=None,
+                global_batching_batch_size_inference=None,
+            ),
+            intra_graph_batching=NS(used_methods="none"),
+            inter_graph_batching=NS(used_method="none"),
+        ),
+        training=NS(
+            encoder=NS(used_methods=encoder, x_is_tuple=False),
+            decoder=NS(used_methods="predict_node_type"),
+        ),
+        feat_inference=NS(_edge_embeds_dir=str(edge_embeds_dir)),
+    )
+
+
+def make_window(seed, n_edges=40, id_pool=30):
+    g = torch.Generator().manual_seed(seed)
+    src = torch.randint(0, id_pool, (n_edges,), generator=g)
+    dst = torch.randint(0, id_pool, (n_edges,), generator=g)
+    t = torch.sort(torch.randint(1_000, 9_000, (n_edges,), generator=g)).values
+
+    def onehot(n_classes):
+        return torch.nn.functional.one_hot(
+            torch.randint(0, n_classes, (n_edges,), generator=g), n_classes
+        ).float()
+
+    msg = torch.cat(
+        [
+            onehot(N_TYPES),                                   # src_type
+            torch.randn(n_edges, EMB_DIM, generator=g),        # src_emb
+            onehot(E_TYPES),                                   # edge_type
+            onehot(N_TYPES),                                   # dst_type
+            torch.randn(n_edges, EMB_DIM, generator=g),        # dst_emb
+        ],
+        dim=1,
+    )
+    assert msg.shape[1] == MSG_LEN
+    return CollatableTemporalData(
+        src=src, dst=dst, t=t, msg=msg, y=torch.zeros(n_edges, dtype=torch.long)
+    )
+
+
+@pytest.fixture
+def artifact_tree(tmp_path):
+    base = tmp_path / "edge_embeds"
+    seed = 0
+    for split, n_windows in [("train", 3), ("val", 2), ("test", 2)]:
+        d = base / split
+        d.mkdir(parents=True)
+        for i in range(n_windows):
+            torch.save(make_window(seed), d / f"window_{i:02d}.TemporalData.simple")
+            seed += 1
+    return base
+
+
+def load_both(artifact_tree, monkeypatch):
+    """Load the same artifact tree through both paths.
+
+    The eager reference needs one adjustment to be comparable on CPU: with
+    `fix_buggy_graph_reindexer=False`, `node_features_reshape` returns `x` as a *view of the
+    reindexer's shared cache buffer*. On a CUDA run (every production run) the subsequent
+    `batch.to("cpu")` device transfer materialises that view into a private tensor, but on a
+    CPU-only run `.to("cpu")` is a no-op and later windows overwrite earlier windows' `x` in
+    place. Cloning after each window reproduces exactly what the device transfer does on CUDA.
+    The low-memory path needs no such fix: it builds a fresh reindexer per window.
+    """
+    from pidsmaker.utils.data_utils import GraphReindexer
+
+    cfg = make_cfg(artifact_tree)
+    monkeypatch.delenv("PIDS_LOW_MEMORY", raising=False)
+    original = GraphReindexer.reindex_graph
+
+    def reindex_then_copy(self, data, **kwargs):
+        data = original(self, data, **kwargs)
+        data.x = data.x.clone()
+        data.node_type = data.node_type.clone()
+        return data
+
+    with monkeypatch.context() as m:
+        m.setattr(GraphReindexer, "reindex_graph", reindex_then_copy)
+        eager = load_all_datasets(cfg, torch.device("cpu"))
+
+    monkeypatch.setenv("PIDS_LOW_MEMORY", "1")
+    slim = load_all_datasets(cfg, torch.device("cpu"))
+    return eager, slim
+
+
+KEPT_ATTRS = [
+    "x", "edge_index", "src", "dst", "t", "y", "edge_type",
+    "node_type", "node_type_src", "node_type_dst",
+    "original_edge_index", "original_n_id",
+]
+DROPPED_ATTRS = ["msg", "x_src", "x_dst"]
+
+
+def test_windows_match_eager_exactly(artifact_tree, monkeypatch):
+    (e_train, e_val, e_test, e_max), (s_train, s_val, s_test, s_max) = load_both(
+        artifact_tree, monkeypatch
+    )
+    assert e_max == s_max
+
+    for e_split, s_split in [(e_train, s_train), (e_val, s_val), (e_test, s_test)]:
+        assert len(e_split) == len(s_split) == 1
+        assert len(e_split[0]) == len(s_split[0])
+        for e_g, s_g in zip(e_split[0], s_split[0]):
+            for attr in KEPT_ATTRS:
+                assert torch.equal(getattr(e_g, attr), getattr(s_g, attr)), attr
+
+
+def test_only_the_payload_attributes_are_dropped(artifact_tree, monkeypatch):
+    (e_train, *_), (s_train, *_) = load_both(artifact_tree, monkeypatch)
+    e_g, s_g = e_train[0][0], s_train[0][0]
+    for attr in DROPPED_ATTRS:
+        assert hasattr(e_g, attr), f"eager path lost {attr}"
+        assert not hasattr(s_g, attr), f"low-memory path kept {attr}"
+
+
+def test_model_input_dimension_is_unchanged(artifact_tree, monkeypatch):
+    """build_model infers in_dim from x_src on eager windows and falls back to x on slim ones;
+    both must agree or the encoder would be built with the wrong input layer."""
+    (e_train, *_), (s_train, *_) = load_both(artifact_tree, monkeypatch)
+    *_, e_in = get_dimensions_from_data_sample(e_train[0][0])
+    *_, s_in = get_dimensions_from_data_sample(s_train[0][0])
+    assert e_in == s_in == EMB_DIM
+
+
+def test_encoder_forward_is_identical(artifact_tree, monkeypatch):
+    from pidsmaker.encoders.rcaid_encoder import RCaidGAT
+
+    (e_train, *_), (s_train, *_) = load_both(artifact_tree, monkeypatch)
+    e_g, s_g = e_train[0][0], s_train[0][0]
+
+    def run(g):
+        torch.manual_seed(0)
+        gat = RCaidGAT(in_dim=EMB_DIM, hid_dim=8, out_dim=N_TYPES, dropout=0.0)
+        gat.eval()
+        with torch.no_grad():
+            return gat(g.x, g.edge_index)["h"]
+
+    assert torch.equal(run(e_g), run(s_g))
+
+
+def test_dropping_msg_actually_frees_its_storage(artifact_tree, monkeypatch):
+    """node_type_src/dst and edge_type come out of extraction as slices of msg. If they stay
+    views, deleting msg frees nothing: each view pins the whole (E, msg_len) buffer, which is
+    the exact allocation this path exists to drop."""
+    _, (s_train, *_) = load_both(artifact_tree, monkeypatch)
+    for g in s_train[0]:
+        for attr in ["node_type_src", "node_type_dst", "edge_type"]:
+            t = getattr(g, attr)
+            storage_bytes = t.storage().size() * t.element_size()
+            assert storage_bytes == t.numel() * t.element_size(), (
+                f"{attr} still views a larger buffer"
+            )
+
+
+def test_incompatible_config_is_rejected_loudly(artifact_tree, monkeypatch):
+    monkeypatch.setenv("PIDS_LOW_MEMORY", "1")
+    cfg = make_cfg(artifact_tree, encoder="tgn")
+    with pytest.raises(ValueError, match="incompatible with low-memory loading"):
+        load_all_datasets(cfg, torch.device("cpu"))
+
+
+def test_flag_off_means_eager(artifact_tree, monkeypatch):
+    monkeypatch.setenv("PIDS_LOW_MEMORY", "0")
+    cfg = make_cfg(artifact_tree)
+    train_data, *_ = load_all_datasets(cfg, torch.device("cpu"))
+    assert hasattr(train_data[0][0], "msg")
diff --git a/tests/test_rcaid_grad_checkpoint_equivalence.py b/tests/test_rcaid_grad_checkpoint_equivalence.py
new file mode 100644
index 0000000..4bc7a24
--- /dev/null
+++ b/tests/test_rcaid_grad_checkpoint_equivalence.py
@@ -0,0 +1,86 @@
+"""PIDS_GRAD_CHECKPOINT=1 must change memory behaviour only: same forward output, same loss,
+same gradients as the plain path. The GAT layers hold no dropout (RCaidGAT's only dropout sits
+outside the checkpointed blocks and draws from the global RNG in the same order either way), so
+on CPU the comparison is exact, not approximate.
+"""
+
+import contextlib
+import os
+import sys
+
+import pytest
+import torch
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from pidsmaker.encoders.rcaid_encoder import RCaidGAT
+
+
+def small_graph(seed=0, n_nodes=50, n_edges=200, in_dim=16):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn(n_nodes, in_dim, generator=g)
+    edge_index = torch.randint(0, n_nodes, (2, n_edges), generator=g)
+    return x, edge_index
+
+
+def run_once(checkpointed, monkeypatch, dropout, train_mode, no_grad=False):
+    if checkpointed:
+        monkeypatch.setenv("PIDS_GRAD_CHECKPOINT", "1")
+    else:
+        monkeypatch.delenv("PIDS_GRAD_CHECKPOINT", raising=False)
+
+    torch.manual_seed(0)
+    model = RCaidGAT(in_dim=16, hid_dim=8, out_dim=3, dropout=dropout)
+    model.train(train_mode)
+
+    x, edge_index = small_graph()
+    torch.manual_seed(1)  # governs dropout1's mask, drawn in the same order on both paths
+    with torch.no_grad() if no_grad else contextlib.nullcontext():
+        out = model(x, edge_index)["h"]
+        loss = out.pow(2).sum()
+    if train_mode and not no_grad:
+        loss.backward()
+        grads = {n: p.grad.clone() for n, p in model.named_parameters()}
+    else:
+        grads = {}
+    return out.detach(), loss.detach(), grads
+
+
+@pytest.mark.parametrize("dropout", [0.0, 0.5])
+def test_training_forward_and_gradients_are_identical(monkeypatch, dropout):
+    out_a, loss_a, grads_a = run_once(False, monkeypatch, dropout, train_mode=True)
+    out_b, loss_b, grads_b = run_once(True, monkeypatch, dropout, train_mode=True)
+    # Forward is bitwise identical (verified down to torch.equal). Gradients are mathematically
+    # identical but accumulate per-head slices in a different order, so they match to float32
+    # summation-order ulps (~1e-8 measured) -- the same class of difference CUDA scatter atomics
+    # introduce on every production run.
+    assert torch.equal(out_a, out_b)
+    assert torch.equal(loss_a, loss_b)
+    assert grads_a.keys() == grads_b.keys()
+    for name in grads_a:
+        assert torch.allclose(grads_a[name], grads_b[name], rtol=1e-5, atol=1e-7), name
+
+
+@pytest.mark.parametrize("no_grad", [False, True])
+def test_inference_output_is_unchanged_by_the_flag(monkeypatch, no_grad):
+    """The flag must move memory, never inference output -- in eval, with or without no_grad.
+
+    The no_grad case is the one that matters in production: the MIA dump calls this encoder under
+    `@torch.no_grad()`, and it is the branch that takes `_gat_one_head` directly rather than
+    through `checkpoint`. Before the head-split was extended to cover it, that branch built one
+    (E, H, C) tensor whole and OOM'd a 32 GB card on CLEARSCOPE's 4.6M-edge windows.
+    """
+    out_a, *_ = run_once(False, monkeypatch, dropout=0.5, train_mode=False, no_grad=no_grad)
+    out_b, *_ = run_once(True, monkeypatch, dropout=0.5, train_mode=False, no_grad=no_grad)
+    assert torch.equal(out_a, out_b)
+
+
+def test_no_grad_inference_matches_grad_enabled_inference(monkeypatch):
+    """Head-splitting under no_grad must agree with the checkpointed grad-enabled eval path.
+
+    Pins the new branch against the one the equivalence argument was originally made for, so a
+    divergence between them cannot hide behind both being 'the checkpointed path'.
+    """
+    out_grad, *_ = run_once(True, monkeypatch, dropout=0.5, train_mode=False, no_grad=False)
+    out_nograd, *_ = run_once(True, monkeypatch, dropout=0.5, train_mode=False, no_grad=True)
+    assert torch.equal(out_grad, out_nograd)
diff --git a/tests/test_rcaid_pseudo_graph_equivalence.py b/tests/test_rcaid_pseudo_graph_equivalence.py
new file mode 100644
index 0000000..97f76dc
--- /dev/null
+++ b/tests/test_rcaid_pseudo_graph_equivalence.py
@@ -0,0 +1,185 @@
+"""The rewritten single-pass R-CAID pseudo-graph builder must produce the same graph as the old
+four-stage pipeline (create -> prune -> relabel -> convert), which is kept verbatim below as the
+oracle.
+
+"Same graph" here means same node set with same attributes and same directed edge multiset. Edge
+timestamps are excluded from the comparison on purpose: they are *arbitrary by design* (new edges
+have no real timestamp, so `add_arbitrary_timestamps_to_graph` assigns uniform randoms over the
+original time range, and its own docstring forbids downstream order-dependence). The new builder
+draws them per root rather than in one vector over the relabelled edge list, so the values differ
+under the same seed; the test instead pins the contract -- every timestamp lies in the original
+graph's [min_t, max_t) range.
+"""
+
+import os
+import sys
+
+import networkx as nx
+import numpy as np
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from pidsmaker.preprocessing.transformation_methods.transformation_rcaid_pseudo_graph import (
+    build_pseudo_graph,
+    identify_root_nodes,
+    main as new_main,
+)
+from pidsmaker.preprocessing.transformation_methods.transformation_utils import (
+    add_arbitrary_timestamps_to_graph,
+)
+
+
+# --------------------------------------------------------------------------------------------
+# Oracle: the previous implementation, verbatim (create_pseudo_graph / prune_pseudo_roots /
+# remove_pseudo_prefix and the old main), as of commit 259adea.
+# --------------------------------------------------------------------------------------------
+def oracle_create_pseudo_graph(G, root_nodes):
+    pseudo_graph = nx.DiGraph()
+
+    for node, attr in G.nodes(data=True):
+        pseudo_graph.add_node(node, **attr)
+
+    for root in root_nodes:
+        pseudo_root = f"pseudo_{root}"
+        pseudo_graph.add_node(pseudo_root, **G.nodes[root])
+
+        descendants = nx.descendants(G, root)
+        for descendant in descendants:
+            pseudo_graph.add_edge(pseudo_root, descendant)
+
+    return pseudo_graph
+
+
+def oracle_prune_pseudo_roots(pseudo_graph, G, prune_threshold):
+    total_nodes_in_G = len(G.nodes())
+    max_allowed_connections = prune_threshold * total_nodes_in_G
+
+    pseudo_roots_to_prune = []
+    for node in pseudo_graph.nodes():
+        if node.startswith("pseudo_"):
+            num_connections = len(list(pseudo_graph.successors(node)))
+            if num_connections > max_allowed_connections:
+                pseudo_roots_to_prune.append(node)
+
+    for pseudo_root in pseudo_roots_to_prune:
+        pseudo_graph.remove_node(pseudo_root)
+
+    return pseudo_graph
+
+
+def oracle_remove_pseudo_prefix(graph):
+    mapping = {node: node.replace("pseudo_", "") for node in graph.nodes()}
+    graph = nx.relabel_nodes(graph, mapping)
+    return graph
+
+
+def oracle_main(graph, use_pruning):
+    root_nodes = identify_root_nodes(graph)
+    pseudo_graph = oracle_create_pseudo_graph(graph, root_nodes)
+    if use_pruning:
+        pseudo_graph = oracle_prune_pseudo_roots(pseudo_graph, graph, 0.5)
+    pseudo_graph = oracle_remove_pseudo_prefix(pseudo_graph)
+    pseudo_graph = add_arbitrary_timestamps_to_graph(original_G=graph, new_G=pseudo_graph)
+    pseudo_graph = nx.MultiDiGraph(pseudo_graph)
+    return pseudo_graph
+
+
+# --------------------------------------------------------------------------------------------
+# Graph generators. Node names are strings (as produced by construction), attributes carry the
+# label/node_type fields featurization reads, edges carry integer 'time'.
+# --------------------------------------------------------------------------------------------
+def random_provenance_graph(seed, n_nodes=40, n_edges=120):
+    rng = np.random.default_rng(seed)
+    G = nx.MultiDiGraph()
+    for i in range(n_nodes):
+        G.add_node(str(i), label=f"label_{i}", node_type=["subject", "file", "netflow"][i % 3])
+    for _ in range(n_edges):
+        u, v = rng.integers(0, n_nodes, size=2)
+        G.add_edge(str(u), str(v), time=int(rng.integers(1_000, 9_000)))
+    return G
+
+
+def star_burst_graph():
+    """One root reaching every node: pruned at threshold 0.5, kept without pruning."""
+    G = nx.MultiDiGraph()
+    for i in range(10):
+        G.add_node(str(i), label=f"l{i}", node_type="subject")
+    for i in range(1, 10):
+        G.add_edge("0", str(i), time=100 + i)
+    # A second, small root so the pruned graph still has edges.
+    G.add_edge("8", "9", time=50)
+    return G
+
+
+def canonical_edges(G):
+    return sorted((u, v) for u, v, _ in G.edges(keys=True))
+
+
+def assert_same_graph(new_G, old_G, original_G):
+    assert isinstance(new_G, nx.MultiDiGraph)
+    assert sorted(new_G.nodes()) == sorted(old_G.nodes())
+    for n in new_G.nodes():
+        assert new_G.nodes[n] == old_G.nodes[n], f"attrs differ on node {n}"
+    assert canonical_edges(new_G) == canonical_edges(old_G)
+
+    times = [d["time"] for _, _, d in original_G.edges(data=True)]
+    min_t, max_t = min(times), max(times)
+    for _, _, d in new_G.edges(data=True):
+        assert min_t <= d["time"] < max_t
+
+
+class _Cfg:
+    def __init__(self, use_pruning):
+        t = type("T", (), {})()
+        t.rcaid_pseudo_graph = type("T", (), {})()
+        t.rcaid_pseudo_graph.use_pruning = use_pruning
+        self.transformation = t
+
+
+@pytest.mark.parametrize("seed", [0, 1, 2, 3])
+@pytest.mark.parametrize("use_pruning", [True, False])
+def test_matches_oracle_on_random_graphs(seed, use_pruning):
+    G = random_provenance_graph(seed)
+    np.random.seed(seed)
+    old = oracle_main(G.copy(), use_pruning)
+    np.random.seed(seed)
+    new = new_main(G.copy(), _Cfg(use_pruning))
+    assert_same_graph(new, old, G)
+
+
+def test_pruning_drops_only_the_giant_root():
+    G = star_burst_graph()
+    np.random.seed(0)
+    old = oracle_main(G.copy(), use_pruning=True)
+    np.random.seed(0)
+    new = new_main(G.copy(), _Cfg(use_pruning=True))
+    assert_same_graph(new, old, G)
+    # Node "0" reaches 9/10 nodes > 0.5 threshold: its edges are gone, the node itself stays.
+    assert "0" in new.nodes()
+    assert new.out_degree("0") == 0
+    # The small root's edge survives.
+    assert ("8", "9") in {(u, v) for u, v, _ in new.edges(keys=True)}
+
+
+def test_without_pruning_keeps_the_giant_root():
+    G = star_burst_graph()
+    np.random.seed(0)
+    old = oracle_main(G.copy(), use_pruning=False)
+    np.random.seed(0)
+    new = new_main(G.copy(), _Cfg(use_pruning=False))
+    assert_same_graph(new, old, G)
+    assert new.out_degree("0") == 9
+
+
+def test_single_pass_builds_no_intermediate_copies():
+    """The point of the rewrite: main returns the one graph build_pseudo_graph constructed,
+    not a relabelled or converted copy of it."""
+    G = random_provenance_graph(seed=7)
+    roots = identify_root_nodes(G)
+    np.random.seed(7)
+    direct = build_pseudo_graph(G, roots, prune_threshold=0.5)
+    np.random.seed(7)
+    via_main = new_main(G, _Cfg(use_pruning=True))
+    assert canonical_edges(direct) == canonical_edges(via_main)
+    assert sorted(direct.nodes()) == sorted(via_main.nodes())
